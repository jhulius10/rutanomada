# ============================================
# 🚌 RUTANÓMADA - VARIABLES DE ENTORNO
# ============================================
# Copia este archivo a .env y completa los valores
# cp .env.example .env
# ============================================

# ============================================
# APP
# ============================================
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1
APP_NAME="RutaNómada"
APP_VERSION=1.0.0

# ============================================
# BASE DE DATOS (PostgreSQL + PostGIS)
# ============================================
DATABASE_URL=postgresql://rutanomada:secret@localhost:5432/rutanomada
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rutanomada
DATABASE_USER=rutanomada
DATABASE_PASSWORD=secret
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ============================================
# REDIS (Opcional - para caché distribuida)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ============================================
# AUTENTICACIÓN Y SEGURIDAD
# ============================================
# Generar con: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-different-from-main
BCRYPT_ROUNDS=12
SESSION_SECRET=change-me-session-secret

# ============================================
# GOOGLE MAPS PLATFORM
# ============================================
# Obtener en: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ROUTES_ENABLED=true
GOOGLE_MAPS_PLACES_ENABLED=true
GOOGLE_MAPS_GEOCODING_ENABLED=true

# Presupuesto diario máximo (USD) - auto-shutdown al superar
GOOGLE_MAPS_DAILY_BUDGET_USD=100
GOOGLE_MAPS_ALERT_THRESHOLDS=50,80,100

# ============================================
# PASARELAS DE PAGO
# ============================================

# Stripe (Internacional)
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEKLY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Mercado Pago (LATAM)
# Obtener en: https://www.mercadopago.com/developers
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PRICE_WEEKLY=
MERCADOPAGO_PRICE_MONTHLY=

# ============================================
# CORS
# ============================================
# Dominios permitidos (separados por coma)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://rutanomada.com
CORS_CREDENTIALS=true

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ============================================
# CACHÉ
# ============================================
ROUTE_CACHE_TTL_MINUTES=15
GEOCODING_CACHE_TTL_MINUTES=1440
PLACES_CACHE_TTL_MINUTES=60
GTFS_CACHE_TTL_MINUTES=10080
CACHE_MAX_SIZE_MB=256

# ============================================
# CUOTAS Y PLANES
# ============================================
FREE_QUERIES_PER_DAY=5
PREMIUM_WEEKLY_PRICE_USD=1.00
PREMIUM_MONTHLY_PRICE_USD=3.99
PREMIUM_YEARLY_PRICE_USD=29.99
PREMIUM_DAILY_LIMIT=500
FAVORITES_FREE_LIMIT=10
HISTORY_FREE_DAYS=7

# ============================================
# LOGS
# ============================================
LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE_MB=50
LOG_MAX_FILES=14

# ============================================
# BACKUPS
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_PATH=/backups
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=rutanomada-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ============================================
# MONITOREO
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
UPTIME_ROBOT_API_KEY=
METRICS_ENABLED=false
METRICS_PORT=9090

# ============================================
# EMAIL (para notificaciones)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rutanomada.com
SMTP_SECURE=false

# ============================================
# GTFS (Fuentes de datos de transporte)
# ============================================
GTFS_IMPORT_DIR=./data/gtfs
GTFS_AUTO_UPDATE=true
GTFS_UPDATE_SCHEDULE=0 2 * * 0

# ============================================
# CIUDADES POR DEFECTO
# ============================================
DEFAULT_CITY=lima
DEFAULT_COUNTRY=PE
DEFAULT_LANGUAGE=es
DEFAULT_TIMEZONE=America/Lima
DEFAULT_CURRENCY=PEN

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ASSISTANT=false
FEATURE_REAL_TIME_DATA=false
FEATURE_OFFLINE_MAPS=false
FEATURE_SOCIAL_LOGIN=true
FEATURE_DARK_MODE=true
FEATURE_MULTI_LANGUAGE=false

# ============================================
# DEBUG
# ============================================
DEBUG=false
SHOW_QUERIES=false
MOCK_PAYMENT=false
MOCK_GOOGLE_MAPS=false
